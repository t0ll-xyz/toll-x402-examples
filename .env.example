# Copy to .env and fill in. Never commit .env.

# ---- seller ----
# The wallet that gets paid (USDG on Robinhood Chain).
PAY_TO=0xYourSellerWallet
# Optional: your ERC-8004 agent id on Robinhood Chain. The facilitator then checks
# that PAY_TO is the agent wallet of that identity (ERC-8478) and refuses a mismatch.
AGENT_ID=
PORT=4021

# ---- buyer ----
# A THROWAWAY wallet with a few cents of USDG (and a little ETH for one approve, if you
# try Permit2 or upto). Never put a wallet you care about here.
PAYER_KEY=0xYourThrowawayPrivateKey
# Who the direct-to-facilitator scripts pay (pay-permit2, pay-upto, escrow, batch).
# Must not be the payer wallet.
PAY_TO_FOR_BUYER=0xSomeOtherWalletYouControl
# Only escrow.ts and the optional batch refund: the seller's key (it signs capture,
# void and refund). Also a throwaway wallet.
SELLER_KEY=
# The paid URL pay-exact.ts calls. Default: the local seller example.
TARGET_URL=http://localhost:4021/weather
# Most a script may pay in one payment, in USDG.
MAX_USDG=0.05
# Nothing moves until you set this to 1. Without it the scripts sign and call /verify only.
SETTLE=0
# Optional RPC. Default: the public Robinhood Chain RPC.
RPC_URL=
